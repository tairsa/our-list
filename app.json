{
  "expo": {
    "name": "our-list",
    "slug": "our-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ourlist",
    "ios": {
      "supportsTablet": true
    },
    "android": {
