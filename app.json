      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "72e2e868-fc59-4fe3-82cd-e2e1ee420d11"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
